[run]
source = .
branch = True
omit =
    */migrations/*
    */tests.py
    config/factories.py
    config/asgi.py
    config/wsgi.py
    config/celery.py
    manage.py
    .venv/*

[report]
show_missing = True
skip_covered = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError

fail_under = 90
